DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/comunidadconecta
DATABASE_SSL=false
SESSION_COOKIE_SECURE=false
SETTINGS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
COMMUNICATION_INGEST_SECRET=replace-with-at-least-32-random-characters
KACUM_CONTROL_PLANE_URL=https://lab.kacum.com
COMMUNITY_CONNECTA_PRODUCT_CODE=comunidad-conecta
APP_VERSION=1.0.0
PORT=3000
RUN_MIGRATIONS=true

# Personalidad de esta instalación. El valor por defecto del código es customer
# para evitar que una instalación real exponga accidentalmente funciones demo.
# comunidad.kacum.com => demo
# instalaciones de clientes => customer
KACUM_INSTANCE_MODE=customer

# Instalación automática KACUM. En una instalación manual puedes dejarlo en false.
INITIAL_ADMIN_BOOTSTRAP_ENABLED=false
INITIAL_COMMUNITY_NAME=Mi comunidad
INITIAL_COMMUNITY_ADDRESS=Pendiente de completar
INITIAL_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@comunidadconecta.local
SEED_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Solo para el seed/demo manual. KACUM no carga datos demo en producción.
SEED_DEMO_PASSWORD=replace-with-a-separate-demo-password
